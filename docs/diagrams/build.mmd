  fonts["mods/wq-party/fonts/*.ttf<br/>+ layers.js (each glyph's colors)"]:::out
  bg["backgrounds/ · scene strips<br/>card stages · space tiles"]:::out
  pal["palettes.py → wq-chrome/scenes.js<br/>each scene's UI colors"]:::out

  gen --> cut
  cut --> anim
  cut --> stage
  cut --> bg
  anim --> lf
